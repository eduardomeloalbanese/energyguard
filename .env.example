# EnergyGuard - Exemplo de variaveis de ambiente
# Copie este arquivo para ".env" e ajuste os valores. NUNCA versione o .env real.

ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

MSSQL_SA_PASSWORD=Your_strong_Pass123!
MSSQL_DB=EnergyGuardDb
DB_PORT=1433

ConnectionStrings__DefaultConnection=Server=db;Database=EnergyGuardDb;User Id=sa;Password=Your_strong_Pass123!;TrustServerCertificate=True;Encrypt=False

Jwt__Key=CHANGE_ME_use_a_long_random_secret_min_32_chars
Jwt__Issuer=EnergyGuard.API
Jwt__Audience=EnergyGuard.Client
Jwt__ExpirationHours=8

IMAGE=energyguard-api:local
